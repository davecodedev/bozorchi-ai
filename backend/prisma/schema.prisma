// Bozorchi AI data model. SQLite for the hackathon; switching to PostgreSQL later is a
// one-line change of `provider` + DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Seller {
  id          Int       @id @default(autoincrement())
  name        String
  region      String    // district / city shown to buyers, e.g. "Chilanzar", "Qibray"
  province    String    @default("toshkent-shahri") // key from backend/src/geo.ts PROVINCES
  bazaar      String    // e.g. "Chorsu Bazaar"
  lat         Float
  lng         Float
  verified    Boolean   @default(false)
  rating      Float     @default(0) // 0–5
  reviewCount Int       @default(0)
  phone       String?
  telegramUserId String? // if set, the bot notifies this seller when a buyer unlocks their contact
  listings    Listing[]
  reviews     Review[]
  reports     PriceHistory[]
  unlocks     ContactUnlock[]
  deals       Deal[]
}

model Listing {
  id         Int      @id @default(autoincrement())
  seller     Seller   @relation(fields: [sellerId], references: [id])
  sellerId   Int
  product    String   // canonical product key, e.g. "tomato"
  pricePerKg Int      // UZS
  minOrderKg Int      @default(1)
  photoUrl   String?  // placeholder images for the demo; real uploads later
  reportedAt DateTime @default(now()) // for staleness decay
  interactions BuyerInteraction[]
  deals      Deal[]

  @@index([product])
  @@index([sellerId, product])
}


/** One price report by a seller. Drives forecasting (P3) and reliability (P5). `region` = province key. */
model PriceHistory {
  id         Int      @id @default(autoincrement())
  seller     Seller   @relation(fields: [sellerId], references: [id])
  sellerId   Int
  product    String
  region     String
  price      Int      // UZS per kg
  reportedAt DateTime

  @@index([product, region, reportedAt])
  @@index([sellerId, reportedAt])
}

/** What a buyer did with a listing. Drives personalised weights (P4). */
model BuyerInteraction {
  id        Int      @id @default(autoincrement())
  buyer     Buyer    @relation(fields: [buyerId], references: [id])
  buyerId   Int
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId Int
  action    String   // "viewed" | "contacted"
  createdAt DateTime @default(now())

  @@index([buyerId, action])
}

model Buyer {
  id             Int       @id @default(autoincrement())
  telegramUserId String    @unique
  name           String?
  username       String?
  tier           String    @default("free") // "free" | "pro" | "max" — see backend/src/tiers.ts
  verifiedBuyer  Boolean   @default(false) // true only when tier = "max"
  upgradedAt     DateTime?
  createdAt      DateTime  @default(now())
  reviews        Review[]
  interactions   BuyerInteraction[]
  unlocks        ContactUnlock[]
  deals          Deal[]
}

/**
 * A negotiated deal between a buyer and a seller for one listing.
 * status: offered → countered | accepted | declined ; countered → accepted | declined. One counter max.
 */
model Deal {
  id            String   @id @default(cuid())
  listing       Listing  @relation(fields: [listingId], references: [id])
  listingId     Int
  buyer         Buyer    @relation(fields: [buyerId], references: [id])
  buyerId       Int
  seller        Seller   @relation(fields: [sellerId], references: [id])
  sellerId      Int
  quantity      Float    // kg
  status        String   // "offered" | "countered" | "accepted" | "declined"
  initialOffer  Float    // buyer's first offer, per kg
  counterOffer  Float?   // seller's one allowed counter, per kg
  agreedPrice   Float?   // per kg, set on acceptance
  totalValue    Float?   // agreedPrice * quantity
  commissionAmt Float?   // total commission (buyer + seller shares), see commission.ts
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([buyerId, createdAt])
  @@index([sellerId, status])
}

/** A buyer revealed a seller's phone + exact location. One row per pair; counted in a rolling window. */
model ContactUnlock {
  id         String   @id @default(cuid())
  buyer      Buyer    @relation(fields: [buyerId], references: [id])
  buyerId    Int
  seller     Seller   @relation(fields: [sellerId], references: [id])
  sellerId   Int
  unlockedAt DateTime @default(now())

  @@unique([buyerId, sellerId])
  @@index([buyerId, unlockedAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  seller    Seller   @relation(fields: [sellerId], references: [id])
  sellerId  Int
  buyer     Buyer    @relation(fields: [buyerId], references: [id])
  buyerId   Int
  rating    Int      // 1–5
  comment   String?
  createdAt DateTime @default(now())
}
