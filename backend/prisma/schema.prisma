// Bozorchi AI data model. SQLite for the hackathon; switching to PostgreSQL later is a
// one-line change of `provider` + DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Seller {
  id          Int       @id @default(autoincrement())
  name        String
  region      String    // district / city shown to buyers, e.g. "Chilanzar", "Qibray"
  province    String    @default("toshkent-shahri") // key from backend/src/geo.ts PROVINCES
  bazaar      String    // e.g. "Chorsu Bazaar"
  lat         Float
  lng         Float
  verified    Boolean   @default(false)
  rating      Float     @default(0) // 0–5
  reviewCount Int       @default(0)
  phone       String?
  listings    Listing[]
  reviews     Review[]
  reports     PriceHistory[]
}

model Listing {
  id         Int      @id @default(autoincrement())
  seller     Seller   @relation(fields: [sellerId], references: [id])
  sellerId   Int
  product    String   // canonical product key, e.g. "tomato"
  pricePerKg Int      // UZS
  minOrderKg Int      @default(1)
  reportedAt DateTime @default(now()) // for staleness decay
  interactions BuyerInteraction[]

  @@index([product])
  @@index([sellerId, product])
}


/** One price report by a seller. Drives forecasting (P3) and reliability (P5). `region` = province key. */
model PriceHistory {
  id         Int      @id @default(autoincrement())
  seller     Seller   @relation(fields: [sellerId], references: [id])
  sellerId   Int
  product    String
  region     String
  price      Int      // UZS per kg
  reportedAt DateTime

  @@index([product, region, reportedAt])
  @@index([sellerId, reportedAt])
}

/** What a buyer did with a listing. Drives personalised weights (P4). */
model BuyerInteraction {
  id        Int      @id @default(autoincrement())
  buyer     Buyer    @relation(fields: [buyerId], references: [id])
  buyerId   Int
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId Int
  action    String   // "viewed" | "contacted"
  createdAt DateTime @default(now())

  @@index([buyerId, action])
}

model Buyer {
  id             Int       @id @default(autoincrement())
  telegramUserId String    @unique
  name           String?
  username       String?
  tier           String    @default("standard") // "standard" | "enterprise"
  upgradedAt     DateTime?
  // daily search quota (standard tier) — see backend/src/limits.ts
  searchesUsed   Int       @default(0)
  searchesDate   String    @default("") // YYYY-MM-DD the counter belongs to
  credits        Int       @default(0) // extra searches bought as packs
  createdAt      DateTime  @default(now())
  reviews        Review[]
  interactions   BuyerInteraction[]
}

model Review {
  id        Int      @id @default(autoincrement())
  seller    Seller   @relation(fields: [sellerId], references: [id])
  sellerId  Int
  buyer     Buyer    @relation(fields: [buyerId], references: [id])
  buyerId   Int
  rating    Int      // 1–5
  comment   String?
  createdAt DateTime @default(now())
}
