# Copy to .env and fill in real values. NEVER commit the real .env.

# --- backend ---
DATABASE_URL="file:./dev.db"
PORT=3000
# LLM query parsing (backend/src/nlp.ts). Set ONE of these; without a key the bot falls back to keyword matching.
# Gemini Developer API ("AIza…") or Vertex AI express-mode ("AQ.…") key:
GEMINI_API_KEY=AIza-FAKE_REPLACE_ME
# or Anthropic:
ANTHROPIC_API_KEY=sk-ant-FAKE_REPLACE_ME
# If both are set, pick one: gemini | anthropic (default: gemini)
# NLP_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_VERTEX=1   # route through Vertex AI instead of the Gemini Developer API

# --- bot ---
BOT_TOKEN=123456789:FAKE_TOKEN_REPLACE_ME
BACKEND_URL=http://localhost:3000
# Must be https:// — for local demos tunnel the backend (cloudflared/ngrok) and use https://<host>/app/
MINIAPP_URL=https://example.com/app/

# Voice messages / voice search are transcribed by the backend via GEMINI_API_KEY (Gemini audio).
