# Copy to .env and fill in real values. NEVER commit the real .env.

# --- backend ---
DATABASE_URL="file:./dev.db"
PORT=3000
# LLM query parsing (backend/src/nlp.ts). Without it the bot falls back to keyword matching.
ANTHROPIC_API_KEY=sk-ant-FAKE_REPLACE_ME

# --- bot ---
BOT_TOKEN=123456789:FAKE_TOKEN_REPLACE_ME
BACKEND_URL=http://localhost:3000
# Must be https:// — for local demos tunnel the backend (cloudflared/ngrok) and use https://<host>/app/
MINIAPP_URL=https://example.com/app/

# --- bot: optional voice transcription (leave unset → bot asks users to type) ---
# OPENAI_API_KEY=sk-FAKE
# STT_MODEL=whisper-1
